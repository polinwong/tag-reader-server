    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "output": "debug_bin",
            "program": "${workspaceFolder}",
            // "args": ["--https"]
        },
        {
            "name": "Launch Server - terminal",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "output": "debug_bin",
            "program": "${workspaceFolder}",
            "console": "integratedTerminal"
            // "args": ["--https"]
        },
        {
            "name": "Launch Server - https",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "output": "debug_bin",
            "program": "${workspaceFolder}",
            "args": ["--https"]
        }
    ]
}